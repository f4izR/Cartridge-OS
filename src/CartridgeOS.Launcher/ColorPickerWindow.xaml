<Window x:Class="CartridgeOS.Launcher.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Color"
        Width="340" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="10" Padding="18"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Pick a Color" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- Saturation/Value field (hue-tinted square, white->transparent left-to-right for saturation,
                 transparent->black top-to-bottom for value) plus a vertical hue strip — the classic
                 click-anywhere color picker layout, same shape as the Windows "Define Custom Colors" panel
                 this replaces, since dragging one point beats dialing three separate RGB sliders. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Grid x:Name="SvSquare" Width="200" Height="200" ClipToBounds="True" Cursor="Cross"
                      MouseLeftButtonDown="SvSquare_MouseLeftButtonDown" MouseMove="SvSquare_MouseMove"
                      MouseLeftButtonUp="SvSquare_MouseLeftButtonUp">
                    <Rectangle x:Name="HueBackground" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="SvCursor" Width="14" Height="14" StrokeThickness="2" Stroke="White"
                             IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="4" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <Border x:Name="HueStrip" Width="24" Height="200" CornerRadius="4" Margin="10,0,0,0"
                        ClipToBounds="True" Cursor="Cross"
                        MouseLeftButtonDown="HueStrip_MouseLeftButtonDown" MouseMove="HueStrip_MouseMove"
                        MouseLeftButtonUp="HueStrip_MouseLeftButtonUp">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Rectangle x:Name="HueCursor" Height="4" Fill="Transparent" Stroke="White" StrokeThickness="2"
                                   IsHitTestVisible="False" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border x:Name="PreviewSwatch" Height="34" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,14" />

            <!-- Numeric entry — typed values, not another slider — for anyone who wants an exact channel
                 value rather than clicking the field/strip above. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox x:Name="RedBox" Style="{StaticResource SettingsTextBoxStyle}"
                             TextAlignment="Center" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0">
                    <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox x:Name="GreenBox" Style="{StaticResource SettingsTextBoxStyle}"
                             TextAlignment="Center" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox x:Name="BlueBox" Style="{StaticResource SettingsTextBoxStyle}"
                             TextAlignment="Center" LostFocus="RgbBox_LostFocus" KeyDown="RgbBox_KeyDown" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Hex" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="HexBox" Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,16"
                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,8,0" />
                <Button Content="Select" Click="Ok_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
