<Window x:Class="CartridgeOS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CartridgeOS.Launcher"
        xmlns:conv="clr-namespace:CartridgeOS.Launcher.Converters"
        xmlns:views="clr-namespace:CartridgeOS.Launcher.Views"
        mc:Ignorable="d"
        Title="Cartridge OS"
        Icon="Assets/app-icon.png"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Crossfade between screens instead of the instant Visibility cut it used to be. All three
             stay technically "Visible" (Opacity 0 + IsHitTestVisible False when not current) rather than
             Collapsed, since Collapsed can't be animated — the tradeoff is the off-screen ones keep their
             own internal timers/animations running (e.g. Recently Played's particle background), which is
             cheap enough here (opacity/transform only, GPU-composited) not to be worth the extra
             complexity of tearing them down and rebuilding on every switch. -->
        <Style x:Key="HomeScreenFadeStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedScreen}" Value="Home">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Deliberately NOT BasedOn the style above — inheriting it would carry over its "Home" DataTrigger
             too (triggers add, they don't replace), which would make this element also react to Home being
             selected. Each of the three needs its own fully independent style. -->
        <Style x:Key="RecentlyPlayedScreenFadeStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedScreen}" Value="RecentlyPlayed">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryScreenFadeStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedScreen}" Value="Library">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Home only: crisp, unblurred selected-game artwork (or the custom wallpaper) — the one screen
             where the background follows selection. UniformToFill crops-to-fill rather than distorting, so
             the art fills this rectangular frame without stretching regardless of its own aspect ratio. -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False"
              Visibility="{Binding IsHomeScreen, Converter={StaticResource BoolToVisibility}}">
            <!-- HomeBackgroundImage, not SelectedGame.Artwork: that's the ~200px tile thumbnail, badly
                 pixelated when stretched full-screen — this is redecoded at 1920px (or the wide SteamGridDB
                 hero image, once fetched) specifically for this. -->
            <Image x:Name="BackgroundArt"
                   Source="{Binding HomeBackgroundImage}"
                   Visibility="{Binding IsUsingGameArtworkBackground, Converter={StaticResource BoolToVisibility}}"
                   Stretch="UniformToFill" />
            <Image x:Name="CustomBackgroundArt"
                   Source="{Binding CustomWallpaperImage}"
                   Visibility="{Binding IsUsingGameArtworkBackground, Converter={StaticResource InverseBoolToVisibility}}"
                   Stretch="UniformToFill" />
            <!-- Bottom-up fade so the carousel/details text over it stays legible regardless of what the art
                 looks like there — there's no blur to fall back on for that here. Starts higher and reaches
                 near-opaque (not just semi-transparent) at the bottom, since a bright/light piece of test
                 art made white text genuinely unreadable at the old, gentler fade. -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000E1420" Offset="0.25" />
                        <GradientStop Color="#F00E1420" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Same idea top-down, shorter reach — just enough to keep the header (logo/nav/status pills)
                 readable over bright artwork, not a full second scrim. -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B00E1420" Offset="0" />
                        <GradientStop Color="#000E1420" Offset="0.18" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- Library / Recently Played: a plain themed gradient, not image- or selection-driven — placeholder
             look for now, revisit once those screens have their own real design. -->
        <Border Grid.ColumnSpan="2" IsHitTestVisible="False"
                Visibility="{Binding IsHomeScreen, Converter={StaticResource InverseBoolToVisibility}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D1016" Offset="0" />
                    <GradientStop Color="#1B2028" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/logo-with-name.png" Height="40"
                       HorizontalAlignment="Left" Stretch="Uniform" />

                <!-- Home / Recently Played / Library — true top-center regardless of the logo's/status area's
                     width, since it spans the whole header row and centers within that full span rather than
                     living inside either side column. -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                        CornerRadius="22" Padding="4"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="AppScreen" Style="{StaticResource NavTabStyle}"
                                     IsChecked="{Binding SelectedScreen, Converter={StaticResource EnumToBoolean}, ConverterParameter=Home}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="AppScreen" Style="{StaticResource NavTabStyle}"
                                     IsChecked="{Binding SelectedScreen, Converter={StaticResource EnumToBoolean}, ConverterParameter=RecentlyPlayed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Recently Played" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="AppScreen" Style="{StaticResource NavTabStyle}"
                                     IsChecked="{Binding SelectedScreen, Converter={StaticResource EnumToBoolean}, ConverterParameter=Library}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Library" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Battery: whichever device actually has one to report — a connected controller if it reports a level, otherwise this machine's own. -->
                    <Border Style="{StaticResource StatusPillStyle}"
                            Visibility="{Binding HasBatteryInfo, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BatteryGlyph}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BatteryLabel}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConnectivityLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Search only filters the Library grid's GamesView — hide the whole pill on Home/Recently
                         Played rather than showing a control that looks like it should do something there too. -->
                    <Border Style="{StaticResource StatusPillStyle}" Padding="6"
                            Visibility="{Binding SelectedScreen, Converter={StaticResource EnumToVisibility}, ConverterParameter=Library}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28"
                                    Command="{Binding ToggleSearchCommand}"
                                    Style="{StaticResource WindowControlButtonBase}" ToolTip="Search" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" Margin="4,0,4,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                     Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusPillStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentTimeText}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDateText}" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource MinimizeButtonStyle}" ToolTip="Settings" Margin="8,0,0,0" />
                    <Button x:Name="PowerButton" Content="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Click="Power_Click"
                            Style="{StaticResource CloseButtonStyle}" ToolTip="Power (Start button / F4)"
                            AutomationProperties.AutomationId="PowerButton" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Home: the selected game's own art fills the whole screen behind this (see the background
                     layer above — Home is the only screen where selection drives the backdrop). Details +
                     carousel anchored to the bottom, per request, rather than the top like the reference image. -->
                <views:HomeView Style="{StaticResource HomeScreenFadeStyle}" />

                <views:RecentlyPlayedView Style="{StaticResource RecentlyPlayedScreenFadeStyle}" />

                <views:LibraryView x:Name="LibraryScreen" Style="{StaticResource LibraryScreenFadeStyle}" />
            </Grid>
        </Grid>

        <!-- Collapsible settings sidebar. Just a Visibility toggle, no slide animation — add one if the hard show/hide feels too abrupt. -->
        <views:SettingsPanel Grid.Column="1" />

        <!-- Error toast — top-center, above everything else (last in z-order). The fullscreen kiosk shell
             has no title bar/status bar for a background failure (a scanner throwing, a DB write failing)
             to show up in otherwise; see MainViewModel.ShowError for what populates this. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" Padding="16,10" MaxWidth="640"
                CornerRadius="10" Background="{StaticResource ErrorBrush}"
                Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="13"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520" />
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding DismissErrorCommand}"
                        Style="{StaticResource WindowControlButtonBase}" Foreground="White"
                        Width="24" Height="24" Margin="10,0,0,0" ToolTip="Dismiss" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
