<Window x:Class="CartridgeOS.Launcher.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartridge OS Overlay"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border CornerRadius="10" Padding="18"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <StackPanel>
            <TextBlock Text="Now Playing" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GameTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,14" />

            <Button x:Name="ReturnButton" Content="Return to Cartridge OS" Command="{Binding ReturnCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
            <Button x:Name="QuitButton" Content="Quit Game" Command="{Binding QuitGameCommand}"
                    Background="{StaticResource ErrorBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0" Padding="10,8" HorizontalAlignment="Stretch" />

            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10" Margin="0,12,0,0" HorizontalAlignment="Center">
                <Run Text="Ctrl+Shift+O or controller " /><Run Text="{Binding MenuButtonLabel}" /><Run Text=" to toggle this overlay" />
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
