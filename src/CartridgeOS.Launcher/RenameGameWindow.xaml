<Window x:Class="CartridgeOS.Launcher.RenameGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Game"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="10" Padding="18"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <StackPanel>
            <TextBlock Text="Rename Game" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />

            <TextBox x:Name="TitleBox" Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,16"
                     KeyDown="TitleBox_KeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Rename" Click="Ok_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
