<Window x:Class="CartridgeOS.Launcher.ScreenSaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Cartridge OS"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="None"
        Background="Black">

    <!-- Two overlapping Images cross-dissolve (both animate opacity simultaneously, in opposite
         directions) rather than one fading over the other — that way which one is on top in the
         visual tree never matters, so there's no z-order bookkeeping to get wrong on each swap. -->
    <Grid>
        <Image x:Name="ImageA" Stretch="UniformToFill" Opacity="1" />
        <Image x:Name="ImageB" Stretch="UniformToFill" Opacity="0" />

        <!-- Gentle vignette so the slideshow reads as calm/ambient rather than a flat photo viewer. -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#66000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Plain white + drop shadow, not the app's own theme brushes — needs to stay readable over
             whatever photo happens to be showing underneath, not just the app's usual dark backgrounds. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText" FontSize="130" FontWeight="Light" Foreground="White" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="DateText" FontSize="28" FontWeight="SemiBold" Foreground="White" Opacity="0.85"
                       HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
