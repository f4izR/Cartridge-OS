<Window x:Class="CartridgeOS.Launcher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartridge OS" Width="560" Height="360"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#0A0D14">
    <Window.Resources>
        <LinearGradientBrush x:Key="CyanGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#60EFFF" Offset="0" />
            <GradientStop Color="#00A8E8" Offset="1" />
        </LinearGradientBrush>
        <!-- Same path data as assets/logo/cartridge.svg's logo mark (untranslated: SVG had it under
             transform="translate(35,25)"), reused as-is since WPF Path mini-language is SVG-compatible. -->
        <PathGeometry x:Key="HousingGeometry" Figures="M 15,25 Q 25,10 50,15 L 75,25 Q 90,32 85,55 L 75,95 Q 70,115 50,115 L 20,110 Q 10,105 15,85 Z" />
        <PathGeometry x:Key="ShellGeometry" Figures="M 35,15 L 75,35 C 105,55 105,75 75,95 L 35,115 C 20,122 10,110 10,95 L 10,35 C 10,20 20,8 35,15 Z" />
    </Window.Resources>

    <Grid>
        <Grid x:Name="LogoRoot" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.85" ScaleY="0.85" />
                </TransformGroup>
            </Grid.RenderTransform>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Logo mark: housing, glow trace, crisp trace, then solid fill on top. Blur-to-sharp is
                     scoped to just this mark — a pixel-shader Effect on the wordmark's TextBlocks kills
                     ClearType hinting and leaves the text looking permanently soft, even at Radius 0. -->
                <Canvas x:Name="LogoMark" Width="95" Height="130" Margin="0,0,18,0">
                    <Path x:Name="HousingFill" Data="{StaticResource HousingGeometry}" Fill="#12324A" Opacity="0" />

                    <!-- Glow copy of the outer shell: same stroke-reveal animation, blurred, builds the glow. -->
                    <Path x:Name="ShellGlow" Data="{StaticResource ShellGeometry}"
                          Stroke="{StaticResource CyanGrad}" StrokeThickness="12"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Opacity="0.9">
                        <Path.Effect>
                            <BlurEffect Radius="18" />
                        </Path.Effect>
                    </Path>

                    <!-- Crisp trace of the outer shell -->
                    <Path x:Name="ShellTrace" Data="{StaticResource ShellGeometry}"
                          Stroke="{StaticResource CyanGrad}" StrokeThickness="12"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                    <!-- Inner d-pad/diamond lines, traced in right after the outer shell -->
                    <Line x:Name="InnerLine1" X1="42" Y1="42" X2="68" Y2="88" Stroke="{StaticResource CyanGrad}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line x:Name="InnerLine2" X1="68" Y1="42" X2="42" Y2="88" Stroke="{StaticResource CyanGrad}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Polygon x:Name="InnerDiamond" Points="55,38 75,65 55,92 35,65" Stroke="{StaticResource CyanGrad}" StrokeThickness="3" Fill="Transparent" Opacity="0.6" />

                    <!-- Full solid fill, fades in on top once the trace completes -->
                    <Path x:Name="ShellFill" Data="{StaticResource ShellGeometry}" Fill="{StaticResource CyanGrad}" Opacity="0" />

                    <Canvas.Effect>
                        <BlurEffect x:Name="LogoBlur" Radius="14" />
                    </Canvas.Effect>
                </Canvas>

                <!-- Wordmark -->
                <StackPanel x:Name="Wordmark" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WordmarkOffset" X="-16" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Cartridge" FontSize="40" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                    <TextBlock Text="-os" FontSize="40" FontWeight="Bold" Foreground="{StaticResource CyanGrad}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
