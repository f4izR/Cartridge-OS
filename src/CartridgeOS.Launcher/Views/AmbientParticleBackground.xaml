<UserControl x:Class="CartridgeOS.Launcher.Views.AmbientParticleBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Purely decorative — IsHitTestVisible="False" above so it never interferes with hit-testing on
         whatever screen hosts it. -->
    <Canvas x:Name="ParticleCanvas" Loaded="ParticleCanvas_Loaded" SizeChanged="ParticleCanvas_SizeChanged" />
</UserControl>
