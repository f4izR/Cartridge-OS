<UserControl x:Class="CartridgeOS.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Home carousel tile: plain DataTemplate over MainViewModel.HomeCarouselSlots, not a
             ListBoxItem/Selector style — center-vs-side sizing is driven directly by HomeCarouselSlot.IsCenter
             via the DataTriggers below, with no dependency on Selector.IsSelected or a ScrollViewer at all. -->
        <DataTemplate x:Key="HomeCarouselItemTemplate">
            <!-- A slot tracks one game for as long as it's in the visible window (see
                 MainViewModel.RefreshHomeCarouselSlots), so this container persists across nav steps —
                 Loaded only fires once, on genuine first appearance. Position/size are owned entirely by
                 HomeView.xaml.cs (HomeCarouselTile_Loaded/ApplyOffset), driven by HomeCarouselSlot.Offset,
                 not by XAML triggers — that's what makes a tile actually slide and grow/shrink as its
                 distance from the center slot changes, instead of snapping in place. -->
            <Border x:Name="Tile" CornerRadius="12"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderThickness="3" Cursor="Hand"
                    MouseLeftButtonUp="HomeCarouselTile_Click"
                    Loaded="HomeCarouselTile_Loaded"
                    RenderTransformOrigin="0.5,0.5">
                <Border.BorderBrush>
                    <SolidColorBrush Color="Transparent" />
                </Border.BorderBrush>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0" CornerRadius="9" Background="{StaticResource SurfaceHoverBrush}">
                        <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"
                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=40}" />
                    </Border>
                    <Border x:Name="ArtworkImage" Grid.Row="0" Margin="0" CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Game.Artwork}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Row="1" Text="{Binding Game.Title}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                               Margin="6,6,6,12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" TextAlignment="Center" />

                    <Border Grid.RowSpan="2" CornerRadius="12" Background="#B0000000"
                            Visibility="{Binding Game.IsLaunching, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Launching..." Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=13}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Zoom-in on the artwork the moment a launch is requested — same idea as Library/Recently
                     Played's tiles, on its own RenderTransform rather than "Tile"'s, since Tile's transform
                     is already driving the pop-in-on-Loaded animation above. -->
                <DataTrigger Binding="{Binding Game.IsLaunching}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.18" Duration="0:0:0.6">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.18" Duration="0:0:0.6">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Cosmetic only — Width/Height/Canvas position are owned by code-behind (see above). -->
                <DataTrigger Binding="{Binding IsCenter}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}" />
                    <Setter TargetName="TitleText" Property="FontSize"
                            Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=18}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCenter}" Value="False">
                    <Setter TargetName="TitleText" Property="FontSize"
                            Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=14}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Home: the selected game's own art fills the whole screen behind this (see MainWindow's background
         layer — Home is the only screen where selection drives the backdrop). Details + carousel anchored
         to the bottom, per request, rather than the top like the reference image. -->
    <!-- Bottom margin cleared to sit above MainWindow's bottom controller-hint bar (~66px tall including
         its own margin) — was 32, which put the carousel tiles' title caption right underneath it. -->
    <Grid Margin="40,0,40,84" VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- PS5-style big title. Margin bottom is the "spacing between game name and tiles" knob. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,44">
            <TextBlock Text="{Binding SelectedGame.Title}" Foreground="White" FontSize="56" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="{Binding SelectedGame.LastPlayedLabel}" Foreground="#D7E9FF" FontSize="14" Margin="0,0,20,0" />
                <TextBlock Text="{Binding SelectedGame.PlaytimeLabel}" Foreground="#D7E9FF" FontSize="14" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- Countdown ring around the Play button: visible only while the Home carousel is actually
                     auto-cycling (MainViewModel.IsHomeCarouselAutoCycling), filling clockwise from empty to
                     full over one auto-cycle interval (HomeCarouselProgress) so it visibly indicates when the
                     game on screen is about to be swapped for the next one. -->
                <Grid Width="56" Height="56" Margin="0,0,14,0">
                    <Ellipse Width="56" Height="56" Stroke="#26FFFFFF" StrokeThickness="3"
                             Visibility="{Binding IsHomeCarouselAutoCycling, Converter={StaticResource BoolToVisibility}}" />
                    <Path Width="56" Height="56" Stretch="None" Stroke="{StaticResource BrandCyanBrush}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="{Binding HomeCarouselProgress, Converter={StaticResource ProgressToArc}, ConverterParameter=56}"
                          Visibility="{Binding IsHomeCarouselAutoCycling, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Solid triangle drawn directly instead of the Segoe MDL2 "Play" glyph (&#xE768;) — that
                         glyph renders outlined rather than filled depending on the OS's installed font
                         version, where a vector Fill always renders solid regardless. -->
                    <Button Style="{StaticResource PlayCircleButtonStyle}"
                            Click="HomePlay_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M0,0 L0,14 L12,7 Z" Fill="{StaticResource TextOnAccentBrush}"
                              Width="12" Height="14" Stretch="Uniform" Margin="2,0,0,0" />
                    </Button>
                </Grid>
                <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="Press " /><Run Text="{Binding ConfirmLabel, Mode=OneWay}" FontWeight="Bold" /><Run Text=" to Play" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Carousel — PS5-style: a fixed window of slots computed from the selected index
             (MainViewModel.HomeCarouselSlots), center one bigger. Left/Right (MainWindow.HandleGamepadAction)
             just changes SelectedGame; the slot list updates in place and HomeView.xaml.cs animates each
             tile to its new Canvas position/size — no Selector/ScrollViewer centering to keep in sync,
             which is what kept breaking. Canvas (not a StackPanel) since tiles are absolutely positioned
             by offset-from-center, not left-to-right document flow — see HomeView.xaml.cs for the layout
             math; 1750x430 = (2*HomeCarouselSideCount+1) slots * 250px pitch, tallest (center) tile height. -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding HomeCarouselSlots}"
                      ItemTemplate="{StaticResource HomeCarouselItemTemplate}"
                      HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Sized off MainViewModel.HomeCarouselCanvasWidth/Height (scaled by UiScale) rather than
                         the old fixed 1750x430 — must stay in lockstep with HomeView.xaml.cs's ApplyOffset,
                         which positions tiles using those same view-model dimensions. -->
                    <Canvas Width="{Binding HomeCarouselCanvasWidth}" Height="{Binding HomeCarouselCanvasHeight}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
