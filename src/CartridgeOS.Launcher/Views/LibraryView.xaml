<UserControl x:Class="CartridgeOS.Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:views="clr-namespace:CartridgeOS.Launcher.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Per-game menu (right-click, or gamepad Menu/Start/Options) — Click handlers in code-behind
             read this control's own DataContext directly, sidestepping ContextMenu's usual data-context/
             visual-tree quirks entirely rather than fighting them with RelativeSource bindings. -->
        <ContextMenu x:Key="GameTileContextMenu" Opened="GameTileContextMenu_Opened">
            <MenuItem Header="Change Wallpaper" Click="ChangeWallpaper_Click" />
            <MenuItem Tag="RevertArtwork" Header="Revert to Previous Artwork" Click="RevertArtwork_Click" />
            <MenuItem Header="Delete Game" Click="DeleteGame_Click" />
        </ContextMenu>

        <Style x:Key="GameTileStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ContextMenu" Value="{StaticResource GameTileContextMenu}" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="GameTile_PreviewMouseRightButtonDown" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile"
                                Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.TileWidth}"
                                Height="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.TileHeight}"
                                Margin="12"
                                CornerRadius="10"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderThickness="3">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="Transparent" />
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="AccentTint" Grid.RowSpan="2" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                                    <Border.Background>
                                        <SolidColorBrush Color="#51E7ED" />
                                    </Border.Background>
                                </Border>
                                <Border Grid.Row="0" Margin="10" CornerRadius="6" Background="{StaticResource SurfaceHoverBrush}">
                                    <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"
                                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=48}" />
                                </Border>
                                <!-- Artwork as the Border's own Background (not a child Image) — Border.CornerRadius only
                                     ever clips its own background paint, never arbitrary child content, so this is what
                                     actually gives the artwork rounded corners instead of square ones poking out.
                                     Its own RenderTransform (separate from the outer Tile's selection-scale one below)
                                     is what zooms in on launch — a second independent transform, not shared, since
                                     IsSelected and IsLaunching are very plausibly both true at once and animating the
                                     same property from two different triggers would fight each other. -->
                                <Border x:Name="ArtworkImage" Grid.Row="0" Margin="10" CornerRadius="6"
                                        RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                           FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=15}"
                                           Margin="12,0,12,14" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" TextAlignment="Center" />

                                <!-- Covers the whole tile the moment a launch is requested — the visible answer to
                                     "did my click register", since a shell launch (Steam/Xbox) can take a few
                                     seconds with zero other feedback otherwise. -->
                                <Border Grid.RowSpan="2" CornerRadius="10" Background="#B0000000"
                                        Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Launching..." Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.UiScale, Converter={StaticResource Scale}, ConverterParameter=14}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Cinematic zoom-in on the artwork the moment a launch is requested, alongside
                                 the existing darken/"Launching..." overlay above — gives the launch a bit of
                                 weight instead of a flat instant cut. Scales back down if IsLaunching flips
                                 back to false (e.g. the "did this actually launch" guess timing out). -->
                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.18" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.18" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="ArtworkImage"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.08" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.08" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Tile"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#49C1ED" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="AccentTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="Tile"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="AccentTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <views:AmbientParticleBackground />

        <ListBox x:Name="GameGridListBox"
                 ItemsSource="{Binding GamesView}"
                 SelectedItem="{Binding SelectedGame}"
                 IsSynchronizedWithCurrentItem="False"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource GameTileStyle}"
                 Margin="24,0,24,24" MouseDoubleClick="GameGridListBox_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>
