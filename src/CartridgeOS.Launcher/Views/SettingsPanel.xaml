<UserControl x:Class="CartridgeOS.Launcher.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Steam/NVIDIA-app-style settings: a fixed-width category rail on the left (TabPanel), the
             selected category's nested settings on the right. Add more categories later by adding
             another TabItem below — each one is a self-contained "main heading" with its own nested
             controls, same shape as the Background category. -->
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <!-- StackPanel, not TabPanel: TabPanel wrap-flows items based on each one's
                                 measured width, and the selected tab's FontWeight="SemiBold" widens it —
                                 that reflow was shifting every tab's position on every selection change.
                                 A vertical StackPanel positions purely by order, immune to width changes. -->
                            <StackPanel DockPanel.Dock="Left" IsItemsHost="True" Width="130" Background="Transparent" />
                            <!-- x:Name reached from code-behind (SettingsPanel.xaml.cs's SelectionChanged
                                 handler) to fade this in on every tab switch — NOT an EventTrigger on
                                 Selector.SelectionChanged here, since several ComboBoxes inside the tab
                                 content are Selectors too and their own selection changes bubble up through
                                 this same routed event, crashing an EventTrigger that expects it to only ever
                                 come from the TabControl itself. -->
                            <ScrollViewer x:Name="ContentHost" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="CategoryBg" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CategoryBg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- One labeled action within a settings section: bold sub-label, a one-line explanation of what it
             does, then the control itself — same "label, then help text, then control" shape most settings
             UIs (Windows Settings, Steam) use, rather than a bare unexplained button. -->
        <Style x:Key="SettingsActionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Focusable="False": these are inline signup links, not real Settings controls — letting D-Pad
             MoveFocus land keyboard focus on a Hyperlink crashed IsDescendantOf's VisualTreeHelper walk
             (Hyperlink is a TextElement, not a Visual, so GetParent throws InvalidOperationException on it). -->
        <Style TargetType="Hyperlink">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource BrandCyanBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrandCyanHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Collapsible settings sidebar. Slides in/out from the right edge and cross-fades, via a DataTrigger
         storyboard rather than the direct Visibility binding this used to have — Visibility itself is
         animated with a delayed keyframe on close so the slide-out is visible before the panel collapses
         (an instant Visibility flip gives WPF no frame to animate away from). -->
    <Border x:Name="RootBorder" Width="460" Padding="24"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrush}"
            Visibility="Collapsed" Opacity="0"
            IsVisibleChanged="RootBorder_IsVisibleChanged">
        <Border.RenderTransform>
            <TranslateTransform X="460" />
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="460" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Settings" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />

            <TabControl x:Name="CategoryTabControl" Style="{StaticResource SettingsTabControlStyle}"
                        SelectionChanged="CategoryTabControl_SelectionChanged">
                <!-- One category per TabItem. Add the next one (e.g. "Interface", "Controller") the same way. -->
                <TabItem Header="Library" Style="{StaticResource SettingsTabItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Scan &amp; Detect" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <TextBlock Text="Trusted Sources" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Looks for games already installed through Steam, Epic, GOG, Ubisoft, EA, Battle.net, and Riot." />
                        <Button Content="Scan for Games" Command="{Binding ScanForGamesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20" />

                        <TextBlock Text="Everything Else" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="A broader heuristic scan for standalone executables and Xbox/Store apps. Results need your confirmation before they're added." />

                        <!-- NVIDIA-style scan-directory picker: pick a folder once, it joins the MRU combo for
                             next time. Empty selection (no folder ever picked) falls back to the default
                             Program-Files/drives sweep — see MainViewModel.FindMoreGamesAsync. -->
                        <TextBlock Text="Scan Directory" Style="{StaticResource SettingsActionLabelStyle}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ScanDirectories}"
                                      SelectedItem="{Binding SelectedScanDirectory}"
                                      IsEditable="False" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseScanDirectoryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                        <CheckBox Content="Scan whole drive (finds games installed a few folders deep, e.g. Riot Games\VALORANT — slower)"
                                  IsChecked="{Binding IsRecursiveScan}" Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12" Margin="0,0,0,8" />
                        <Button Content="Find More Games" Command="{Binding FindMoreGamesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20" />

                        <TextBlock Text="Manage Games" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <TextBlock Text="Add Manually" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Pick an executable directly — useful for anything the scanners above didn't find." />
                        <Button Content="+ Add Game" Command="{Binding AddGameCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20" />

                        <TextBlock Text="Remove Selected" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Removes whatever game is currently selected in your library. Only removes it from Cartridge OS — the game itself isn't touched." />
                        <Button Content="Remove Game" Command="{Binding RemoveGameCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20" />

                        <TextBlock Text="Storage" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <TextBlock Text="Drive to Display" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Which drive's storage the Recently Played screen shows — useful if your games live on a different drive than Windows." />
                        <ComboBox ItemsSource="{Binding StorageDrives}"
                                  SelectedItem="{Binding SelectedStorageDrive}"
                                  IsEditable="False" HorizontalAlignment="Left" MinWidth="160" />

                        <TextBlock Text="Artwork Sources" Style="{StaticResource SettingsSectionHeadingStyle}" Margin="0,20,0,10" />

                        <!-- Box art is fetched using a bundled API key shared by every install. Leaving these
                             blank uses that bundled key — filling one in switches this install to your own,
                             e.g. if the shared one ever gets rate-limited. Both providers give free keys. -->
                        <TextBlock Text="SteamGridDB API Key" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}">
                            <Run Text="Optional — leave blank to use the built-in key. Get your own free key at" />
                            <Hyperlink NavigateUri="https://www.steamgriddb.com/profile/preferences/api" RequestNavigate="Hyperlink_RequestNavigate">steamgriddb.com/profile/preferences/api</Hyperlink><Run Text="." />
                        </TextBlock>
                        <TextBox Text="{Binding SteamGridDbApiKeyOverride, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,16" />

                        <TextBlock Text="TheGamesDB API Key" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}">
                            <Run Text="Optional — leave blank to use the built-in key. Get your own free key at" />
                            <Hyperlink NavigateUri="https://forums.thegamesdb.net" RequestNavigate="Hyperlink_RequestNavigate">forums.thegamesdb.net</Hyperlink><Run Text="." />
                        </TextBlock>
                        <TextBox Text="{Binding TheGamesDbApiKeyOverride, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBoxStyle}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Wallpaper" Style="{StaticResource SettingsTabItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Background" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <RadioButton Content="Selected game's artwork" GroupName="WallpaperMode"
                                     Style="{StaticResource SettingsRadioStyle}"
                                     IsChecked="{Binding WallpaperMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=SelectedGameArtwork}" />
                        <RadioButton Content="Custom image" GroupName="WallpaperMode"
                                     Style="{StaticResource SettingsRadioStyle}"
                                     IsChecked="{Binding WallpaperMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=CustomImage}" />

                        <Button Content="Browse..." Command="{Binding ChooseWallpaperCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding CustomWallpaperPath}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Sound" Style="{StaticResource SettingsTabItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Sound" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <CheckBox Content="Navigation Sound" IsChecked="{Binding NavigationSoundEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                  Margin="0,0,0,4" Cursor="Hand" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="The blip sound when moving between tiles." />

                        <CheckBox Content="Confirm Sound" IsChecked="{Binding ConfirmSoundEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                  Margin="0,0,0,4" Cursor="Hand" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="The sound when confirming a selection." />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Screen Saver" Style="{StaticResource SettingsTabItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Screen Saver" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <CheckBox Content="Enabled" IsChecked="{Binding ScreenSaverEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                  Margin="0,0,0,16" Cursor="Hand" />

                        <TextBlock Text="Start After" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="How long the PC needs to be idle (keyboard, mouse, and controller) before the screen saver takes over." />
                        <ComboBox ItemsSource="{Binding InactivityOptions}"
                                  SelectedValuePath="Minutes" DisplayMemberPath="Label"
                                  SelectedValue="{Binding ScreenSaverInactivityMinutes}"
                                  IsEditable="False" HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,16" />

                        <TextBlock Text="Volume" Style="{StaticResource SettingsActionLabelStyle}" />
                        <Slider Value="{Binding ScreenSaverVolume}" Minimum="0" Maximum="1" TickFrequency="0.1"
                                IsSnapToTickEnabled="False" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" ValueChanged="Slider_ValueChanged" />

                        <TextBlock Text="Images" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Uses the built-in photos by default. Point at your own folder to use only those instead." />
                        <TextBlock Text="{Binding ScreenSaverImagesFolder, TargetNullValue='Default'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Browse..." Command="{Binding BrowseScreenSaverImagesCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Use Default" Command="{Binding ClearScreenSaverImagesCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="Music" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="Uses the built-in tracks by default. Point at your own folder to use only those instead." />
                        <TextBlock Text="{Binding ScreenSaverMusicFolder, TargetNullValue='Default'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Browse..." Command="{Binding BrowseScreenSaverMusicCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Use Default" Command="{Binding ClearScreenSaverMusicCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <Button Content="Preview Now" Click="PreviewScreenSaver_Click"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                    </StackPanel>
                </TabItem>
                <!-- Static reference, not settings — matches keybinds.md (the source of truth this mirrors,
                     kept in sync by hand since it's a small fixed list) but trimmed to what a player needs
                     to know, not the "why it's mapped this way" reasoning that file carries for developers. -->
                <TabItem Header="Controls" Style="{StaticResource SettingsTabItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Everywhere" Style="{StaticResource SettingsSectionHeadingStyle}" />

                        <TextBlock Text="D-Pad / Left Stick" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Move the selection" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="A / ✕" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Confirm — launch the selected game, or activate whatever's focused in a menu" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="B / ○" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Back — closes whatever's open on top (Settings, then Search)" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Y / △" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Add Game (opens the file picker)" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="X / □" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Search — Library screen only" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Menu (☰) / Options" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Opens the selected game's options (Change Wallpaper / Delete Game) — Library screen only" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="View / Share" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Opens/closes this Settings panel" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="LB / L1 and RB / R1" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Switch between Home, Recently Played, and Library" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Guide / PS button" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Toggles the in-game overlay while a game is running, opens the Power menu otherwise" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Right Stick / Right Trigger" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Moves the mouse cursor / clicks, for anything not reachable with the D-Pad" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Left Trigger + Right Trigger (held together)" Style="{StaticResource SettingsActionLabelStyle}" />
                        <TextBlock Text="Locks/unlocks the stick-driven cursor — handy if a worn stick drifts and drags the cursor around" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,20" />

                        <TextBlock Text="Testing the overlay" Style="{StaticResource SettingsSectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                   Text="The overlay only exists while a game launched from here is actually running — there's nothing to open from the launcher itself. Launch any game, then press Guide/PS (or Ctrl+Shift+O on keyboard) to bring it up over the game; press it again, or B/○, to close it." />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
